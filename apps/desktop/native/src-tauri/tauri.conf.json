{
  "build": {
    "distDir": "../dist-stage",
    "devPath": "../dist-stage"
  },
  "package": {
    "productName": "SEIS Inspector",
    "version": "0.1.0"
  },
  "tauri": {
    "windows": [
      {
        "title": "SEIS Inspector",
        "url": "cockpit.html",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.seis.inspector",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.png"
      ],
      "targets": ["deb", "appimage", "msi", "nsis"]
    },
    "allowlist": {
      "shell": { "open": true }
    },
    "security": {
      "csp": null
    }
  }
}
