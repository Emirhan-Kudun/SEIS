  "manifestSources": [
    {
      "id": "polyglot",
      "path": "polyglot/manifest.json",
      "pathField": "path"
    }
  ],
  "forbiddenPathFragments": [
    "node_modules/",
    ".next/",
    "runtime/",
    "logs/",
    "__MACOSX/",
    ".DS_Store"
  ]
}
