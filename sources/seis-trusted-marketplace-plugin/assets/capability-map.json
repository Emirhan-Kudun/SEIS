{
  "version": 1,
  "id": "seis-trusted-marketplace-capability-map",
  "summary": "Capability routing map for the SEIS Trusted Marketplace plugin.",
  "capabilities": [
    {
      "id": "data-engineering",
      "label": "Data Engineering",
      "designerValue": "Prepare reliable data, spreadsheet, warehouse, and content pipelines before dashboards or AI workflows use them.",
      "routingSignals": [
        "database",
        "warehouse",
        "spreadsheet",
        "ETL",
        "schema",
        "data quality"
      ],
      "activationGates": [
        "target dataset known",
        "read/write scope explicit",
        "credentials outside repository",
        "sample or dry-run available"
      ],
      "qualitySignals": [
        "schema contract",
        "source freshness",
        "row-level sampling",
        "rollback path"
      ]
    },
    {
      "id": "development",
      "label": "Development",
